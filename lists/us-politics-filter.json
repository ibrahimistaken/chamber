{
  "$schema": "../schema/list.schema.json",
  "id": "us-politics-filter",
  "name": "US Politics & Elections Filter",
  "description": "Filters partisan US political debates, election campaigns, Congressional disputes, and White House talking points.",
  "author": "chamber",
  "version": 1,
  "tags": {
    "country": "US",
    "lang": "en",
    "category": "siyaset"
  },
  "mode": "collapse",
  "rules": {
    "keywords": [
      "White House",
      "POTUS",
      "Joe Biden",
      "Donald Trump",
      "Kamala Harris",
      "JD Vance",
      "Nancy Pelosi",
      "Mitch McConnell",
      "Chuck Schumer",
      "Mike Johnson",
      "Ron DeSantis",
      "Gavin Newsom",
      "Democrats",
      "Republicans",
      "GOP",
      "DNC",
      "RNC",
      "Capitol Hill",
      "Senate vote",
      "House of Representatives",
      "filibuster",
      "electoral college",
      "presidential election",
      "midterm election",
      "swing state",
      "bipartisan",
      "impeachment",
      "executive order",
      "Supreme Court justice",
      "SCOTUS",
      "gerrymandering",
      "debt ceiling",
      "government shutdown",
      "political rally",
      "campaign trail",
      "super PAC",
      "town hall meeting",
      "primary election",
      "State of the Union"
    ],
    "exclude": [
      "science policy",
      "weather forecast",
      "NASA announcement",
      "technology regulation",
      "academic research",
      "public health data",
      "historical archive"
    ]
  }
}
